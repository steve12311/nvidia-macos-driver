#version 460
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly restrict buffer Params { uint mode; } p;
layout(set = 0, binding = 1, std430) readonly restrict buffer Src { uint16_t data[]; } src;
layout(set = 0, binding = 2, std430) writeonly restrict buffer Dst { uint data[]; } dst;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint offset = p.mode == 2 ? (i & 1) : p.mode;
    uint idx = i * 8 + offset;
    dst.data[i] = uint(src.data[idx]) * 3 + uint(src.data[idx + 1]) * 5 +
                  uint(src.data[idx + 2]) * 7 + uint(src.data[idx + 3]) * 11 +
                  uint(src.data[idx + 4]) * 13 + uint(src.data[idx + 5]) * 17 +
                  uint(src.data[idx + 6]) * 19 + uint(src.data[idx + 7]) * 23;
}
