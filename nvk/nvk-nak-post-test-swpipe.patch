+static bool
+nak_cg_swpipe_affine_step(nir_phi_instr *phi, nir_block *back, uint64_t *step)
+{
+   nir_def *update = nir_phi_get_src_from_block(phi, back)->src.ssa;
+   nir_instr *instr = nir_def_instr(update);
+   if (phi->def.num_components != 1 || instr->type != nir_instr_type_alu)
+      return false;
+
+   nir_alu_instr *add = nir_instr_as_alu(instr);
+   if (add->op != nir_op_iadd)
+      return false;
+
+   for (unsigned i = 0; i < 2; i++) {
+      if (add->src[i].src.ssa == &phi->def && add->src[i].swizzle[0] == 0 &&
+          nir_src_is_const(add->src[1 - i].src)) {
+         *step = nir_alu_src_as_uint(add->src[1 - i]);
+         return true;
+      }
+   }
+   return false;
 }
 
