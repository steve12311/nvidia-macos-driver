+static bool
+nak_cg_swpipe_apply_post(nir_shader *nir, struct nak_cg_swpipe_plan *p)
+{
+   struct set *slice = _mesa_pointer_set_create(NULL);
+   for (unsigned i = 0; i < p->nloads; i++)
+      nak_cg_swpipe_collect_addr_slice(nir_def_instr(p->loads[i]->src[0].ssa), p->a, p->z, slice);
+   if (slice->entries > 32) {
+      _mesa_set_destroy(slice, NULL);
+      return false;
+   }
+
+   nir_block *pre = nir_cf_node_as_block(nir_cf_node_prev(&p->loop->cf_node));
+   nir_builder b = nir_builder_at(nir_before_cf_node(&p->loop->cf_node));
+   nir_def *init_loads[ARRAY_SIZE(p->loads)], *next_loads[ARRAY_SIZE(p->loads)];
+   nak_cg_swpipe_post_loads(&b, p, pre, false, slice, init_loads);
+   b.cursor = nir_after_phis(p->a);
+   nak_cg_swpipe_post_loads(&b, p, pre, true, slice, next_loads);
+   _mesa_set_destroy(slice, NULL);
+
+   for (unsigned i = 0; i < p->nloads; i++) {
+      nir_def *def = &p->loads[i]->def;
+      nir_phi_instr *phi = nir_phi_instr_create(nir);
+      nir_def_init(&phi->instr, &phi->def, def->num_components, def->bit_size);
+      nir_phi_instr_add_src(phi, pre, init_loads[i]);
+      nir_phi_instr_add_src(phi, p->z, next_loads[i]);
+      nir_instr_insert(nir_after_phis(p->a), &phi->instr);
+      nir_def_replace(def, &phi->def);
+   }
+   return true;
 }
 
