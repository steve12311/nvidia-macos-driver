+static void
+nak_cg_swpipe_post_loads(nir_builder *b, struct nak_cg_swpipe_plan *p, nir_block *pre,
+                        bool next, const struct set *slice, nir_def **loads)
+{
+   struct hash_table *remap = _mesa_pointer_hash_table_create(NULL);
+   nir_foreach_phi(phi, p->a) {
+      uint64_t step;
+      if (!nak_cg_swpipe_affine_step(phi, p->z, &step))
+         continue;
+      nir_def *value = next ? nir_iadd_imm(b, &phi->def, step) :
+                             nir_phi_get_src_from_block(phi, pre)->src.ssa;
+      _mesa_hash_table_insert(remap, &phi->def, value);
+   }
+
+   nir_def *pred = nir_imm_true(b);
+   if (next) {
+      nir_def *iv = nak_cg_punroll_remap(remap, &p->iv->def);
+      pred = p->exit_op == nir_op_ige ? nir_ilt(b, iv, p->n) : nir_ult(b, iv, p->n);
+   }
+
+   nir_foreach_instr(instr, p->a) {
+      if (_mesa_set_search(slice, instr))
+         nir_builder_instr_insert(b, nir_instr_clone_deep(b->shader, instr, remap));
+   }
+   for (unsigned i = 0; i < p->nloads; i++) {
+      nir_intrinsic_instr *load = p->loads[i];
+      nir_def *addr = nak_cg_punroll_remap(remap, load->src[0].ssa);
+      loads[i] = nak_cg_swpipe_emit_pred_load(b, load, addr, pred);
+   }
+   _mesa_hash_table_destroy(remap, NULL);
+}
